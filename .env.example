# Required GitHub Actions secrets
GEMINI_API_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_TO=

# Optional GitHub Actions variables
SMTP_USE_TLS=true
BOT_MODEL=gemini-3.1-flash-lite
BOT_TOPIC=one useful observation for builders, creators, or founders
BOT_STYLE=concise, clear, useful, and non-clickbait
BOT_COUNT=3
TWEET_MAX_CHARS=280
EXTRA_INSTRUCTIONS=
ENABLE_GOOGLE_SEARCH_GROUNDING=false
